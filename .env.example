# Data directory for book catalog, vector index, and covers
# Default: ~/.whataboutthisbook
# DATA_DIR=/var/data/whataboutthisbook

# Set to "true" to run as a public read-only site
# Hides upload UI, blocks file uploads and book deletion
# PUBLIC_MODE=true

# AWS profile used for Bedrock access (required for SSO; app auto-runs aws sso login)
# AWS_PROFILE=ki-bedrock-inference-261916864828

# Bedrock settings
# AWS_REGION=eu-central-1
# BEDROCK_MODEL_ID=eu.anthropic.claude-opus-4-6-v1
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Librarians (one per book) run on a cheaper model when your account can invoke one.
# "Auto" (Settings → Advanced) tries these in order, then BEDROCK_MODEL_ID; what works is
# remembered in ops/model-routing.json and re-checked after 7 days. Default: Haiku 4.5,
# then Sonnet 4.5, with the same region prefix as BEDROCK_MODEL_ID (eu. / us. / apac. / global.).
# BEDROCK_SPECIALIST_MODEL_IDS=eu.anthropic.claude-haiku-4-5-20251001-v1:0,eu.anthropic.claude-sonnet-4-5-20250929-v1:0
