# Data directory for book catalog, vector index, and covers
# Default: ~/.whataboutthisbook
# DATA_DIR=/var/data/whataboutthisbook

# Set to "true" to run as a public read-only site
# Hides upload UI, blocks file uploads and book deletion
# PUBLIC_MODE=true

# AWS profile used for Bedrock access (recommended with SSO)
# AWS_PROFILE=ki-bedrock-inference-261916864828

# Bedrock settings
# AWS_REGION=eu-central-1
# BEDROCK_MODEL_ID=eu.anthropic.claude-opus-4-6-v1
# BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
