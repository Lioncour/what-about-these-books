{
  "name": "whataboutthisbook",
  "version": "0.2.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron .",
    "dev:web": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "npm run build && cross-env NODE_ENV=production electron .",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "eval:harness": "node scripts/run-eval.mjs",
    "eval:chat": "node scripts/run-eval.mjs --chat",
    "dist": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "trace:server": "node scripts/trace-server-modules.mjs",
    "dist:setup": "node scripts/setup-user-config.mjs && powershell -ExecutionPolicy Bypass -File scripts/create-desktop-shortcut.ps1",
    "electron:start": "cross-env NODE_ENV=production electron .",
    "test": "vitest run",
    "smoke": "node scripts/electron-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1038.0",
    "epub2": "^3.0.2",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.4.0",
    "vectra": "^0.12.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.whataboutthisbook.app",
    "productName": "What About This Book",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json",
      ".env.example",
      "!node_modules"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          ".next/**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "What About This Book"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "Office",
      "executableName": "whataboutthisbook",
      "artifactName": "WhatAboutThisBook-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "public/icon.png"
    }
  },
  "description": "A reading room for the books you keep: ask questions about your own library.",
  "author": "Lioncour"
}
